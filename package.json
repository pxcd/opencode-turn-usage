{
  "name": "opencode-turn-usage",
  "version": "0.1.1",
  "description": "Per-turn model token accounting for OpenCode Desktop and terminal",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    "./gui-experimental": "./dist/gui-experimental.cjs",
    "./tui": "./dist/tui.js",
    "./accounting": "./dist/accounting.js"
  },
  "scripts": {
    "test": "node --conditions=browser --import tsx --test test/*.test.ts",
