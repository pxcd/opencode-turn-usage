      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/plugin": "2.2.7",
    "@types/jsdom": "27.0.0",
    "@types/node": "24.19.2",
    "esbuild": "0.25.12",
    "jsdom": "27.4.0",
    "solid-js": "1.9.17",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "6.4.6",
    "vite-plugin-solid": "2.11.0"
  },
